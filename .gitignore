# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan
tfplan*

# Ignore backup files
*.bak

# Ignore lock files (keep .terraform.lock.hcl)
# Uncomment if you want to ignore lock files:
# **/.terraform.lock.hcl

# Mac files
.DS_Store

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
*.tmp
ejemplo-nueva-cuenta.tfvars
